# LF everywhere: CRLF in Dart files fails `dart format --set-exit-if-changed`
# for Windows contributors (AGENTS.md "Platform / OS quirks").
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ttf binary
*.otf binary
*.jar binary
*.jks binary
*.keystore binary

# Collapsed in GitHub diffs and excluded from language stats.
*.g.dart linguist-generated=true
*.freezed.dart linguist-generated=true
apps/mobile/lib/l10n/generated/** linguist-generated=true
pubspec.lock linguist-generated=true
